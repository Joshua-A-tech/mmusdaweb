# Neon PostgreSQL Database Connection URL
Database_URL="postgresql://user:password@host/neondb?sslmode=require"

# Server Port (optional, defaults to 5000 or assigned by host like Render/Heroku)
PORT=5000

# CORS Allowed Origins (comma separated production domains)
ALLOWED_ORIGINS="https://your-frontend.vercel.app,https://your-admin.vercel.app,https://mmusda.org"

# JWT Secret for admin authentication
JWT_SECRET="your_jwt_secret_key"

# Gmail SMTP for sending contact/prayer emails
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"

# YouTube API for sermon and video syncing
YOUTUBE_API_KEY="your_youtube_api_key"
YOUTUBE_CHANNEL_ID="your_youtube_channel_id"

# Cloudinary for photo uploads
CLOUD_NAME="your_cloudinary_cloud_name"
CLOUD_API_KEY="your_cloudinary_api_key"
CLOUD_API_SECRET="your_cloudinary_api_secret"
